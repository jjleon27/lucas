# ==========================================================================
#  LUCAS — backend/.env
# --------------------------------------------------------------------------
#  Cómo usar este archivo:
#    1. Copia este archivo a `.env` (mismo folder):
#         cp .env.example .env
#    2. Rellena los campos marcados con ← PÉGALO AQUÍ
#    3. Reinicia el backend:
#         docker compose up --build   (o)   uvicorn app.main:app --reload
#    4. Verifica con:  curl http://localhost:8000/ai/status
#       → debe devolver {"available": true, "provider": "openai"}
# ==========================================================================

# ---- Core ----
DATABASE_URL=postgresql://lucas:lucas@db:5432/lucas
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=10080   # 7 días

# ---- Storage ----
STORAGE_BACKEND=local              # local | s3
LOCAL_STORAGE_DIR=./uploads

# Solo si STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=

# ==========================================================================
#  IA — ELIGE UN PROVEEDOR Y PEGA TU API KEY ABAJO
# --------------------------------------------------------------------------
#  Sin esto, LUCAS funciona pero sin chat real ni lectura inteligente de
#  boletas. Basta UNO de los tres proveedores; si pones varios, el más
#  barato gana o puedes forzarlo con AI_PROVIDER.
# ==========================================================================

# Proveedor preferido. Déjalo vacío para elegir automáticamente el que tenga
# key. Opciones: openai | anthropic | gemini
AI_PROVIDER=

# ---- Opción A: OpenAI (el más popular, bueno en español) -----------------
# 1. Crea cuenta en https://platform.openai.com/signup
# 2. Carga saldo (mínimo USD 5) en  Billing → Add payment method
# 3. Genera la key en  https://platform.openai.com/api-keys  (botón "Create new secret key")
# 4. Copia la key completa (empieza con sk-...) y pégala aquí:
OPENAI_API_KEY=                     # ← PÉGALO AQUÍ (ej: sk-proj-abc123...)
OPENAI_MODEL=gpt-4o-mini            # barato y suficiente para el MVP

# ---- Opción B: Anthropic Claude (mejor razonamiento financiero) ----------
# 1. Crea cuenta en  https://console.anthropic.com/
# 2. Billing → agrega tarjeta
# 3. Genera la key en  Settings → API Keys
ANTHROPIC_API_KEY=                  # ← PÉGALO AQUÍ (ej: sk-ant-api03-...)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Opción C: Google Gemini (el más barato) -----------------------------
# 1. Ve a  https://aistudio.google.com/app/apikey
# 2. "Create API key" — no requiere tarjeta para el free tier
GOOGLE_API_KEY=                     # ← PÉGALO AQUÍ (ej: AIza...)
GOOGLE_MODEL=gemini-1.5-flash

# ---- Login social (opcional) ---------------------------------------------
# OAuth client ID de Google Cloud Console
# (APIs & Services → Credentials → Create OAuth client → Web app).
# Authorized JS origin: http://localhost:3000
GOOGLE_CLIENT_ID=

# Login sin password (solo email). Útil para demos locales.
# Apágalo en producción.
ALLOW_PASSWORDLESS=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
