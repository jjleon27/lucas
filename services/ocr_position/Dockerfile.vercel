FROM python:3.12-slim

# OCR_THREADS: hilos de onnxruntime (el código igual nunca usa más que los
# núcleos que ve el contenedor). Sin paquetes de sistema: los modelos PP-OCR
# vienen dentro del paquete `rapidocr` de PyPI y OpenCV es la variante
# headless (no necesita libGL).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OCR_THREADS=4 \
    PORT=8000

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port $PORT"]
